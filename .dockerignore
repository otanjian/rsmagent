# Only shipped server resources enter the build context. Keep this list in sync
# with the runtime imports, skills, scenes and web resources, not local state.
**
!app.py
!config.py
!config-template.json
!pyproject.toml
!requirements.txt
!requirements-optional.txt
!requirements-scenes.txt
!requirements/
!requirements/production-linux-py311.lock
!requirements/production-linux-arm64-py311.lock
!LICENSE
!agent/
!agent/**
!auth/
!auth/**
!bridge/
!bridge/**
!channel/
!channel/**
!cli/
!cli/**
!common/
!common/**
!contracts/
!contracts/**
!integrations/
!integrations/**
!models/
!models/**
!plugins/
!plugins/**
!scenes/
!scenes/**
!Scene/
!Scene/**
!skills/
!skills/**
!tools/
!tools/**
!translate/
!translate/**
!voice/
!voice/**
!webhelp/
!webhelp/**
!docker/
docker/**
!docker/Dockerfile.latest
!docker/entrypoint.sh
!Dockerfile
!.dockerignore

# Runtime state is forbidden even if it is created inside a shipped directory.
**/.git
**/.git/**
**/.env
**/.env.*
**/.dev.vars
**/.preview_secret
**/.cow
**/.cow/**
**/.venv
**/.venv/**
**/node_modules
**/node_modules/**
**/__pycache__
**/__pycache__/**
**/*.pyc
**/*.pyo
**/*.log
**/*.log.*
**/*.db
**/*.db-*
**/*.db.*
**/*.sqlite
**/*.sqlite3
**/*.sqlite-*
**/*.sqlite3-*
**/*.bak
**/*.bak-*
**/*.pem
**/*.key
**/config.json
**/config.json.*
**/client_config.json
**/user_datas.pkl
**/backups
**/backups/**
**/.DS_Store
# Public help-site metadata is source, unlike an instance config.json.
!webhelp/config.json
# Plugin setup reads these shipped templates; runtime config.json stays out.
!plugins/**/config.json.template
!voice/**/config.json.template

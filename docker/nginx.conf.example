# Replace the domain/certificate paths. Nginx runs on the host in this example.
server {
    listen 80;
    server_name agent.example.com;
    return 308 https://agent.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name agent.example.com;
    ssl_certificate /etc/ssl/agent/fullchain.pem;
    ssl_certificate_key /etc/ssl/agent/privkey.pem;
    client_max_body_size 100m;

    # Compress only the non-sensitive public console shell and its first-party
    # JS/CSS. `gzip_types` deliberately omits application/json (API and user
    # data) and text/event-stream (SSE), and Nginx never compresses WebSocket
    # upgrades -- so authentication, business data and streaming endpoints keep
    # their existing delivery behavior, including this server's
    # `proxy_buffering off`. `gzip_vary` adds `Vary: Accept-Encoding`; the
    # versioned JS/CSS keep their own ETag/immutable caching and the shell keeps
    # its no-store response, which gzip does not change.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/html text/css text/javascript application/javascript;

    location / {
        proxy_pass http://127.0.0.1:9899;
        proxy_http_version 1.1;
        proxy_set_header Host agent.example.com;
        # Overwrite client-supplied values; do not append their forwarding chain.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host agent.example.com;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    # The optional device channel, and the only route that is NOT the Web app.
    #
    # `/api/desktop/connect` is a WebSocket upgrade served by the standalone
    # gateway (`python -m integrations.desktop.gateway`, loopback 127.0.0.1:9877
    # by default) -- the WSGI Web app cannot upgrade it at all
    # (channel/web/fork/runtime.py). Forwarding it to 9899, or leaving the
    # `Connection ""` above in force, turns every device connection into a
    # failed upgrade, and the client then reports a device-channel fault while
    # the server business looks fine -- which is exactly the pair of states the
    # deployment has to keep separate (change
    # harden-windows-desktop-reliability, task 6.3).
    #
    # `Upgrade`/`Connection` are what make the handshake work; the long read and
    # send timeouts cover heartbeats and idle leases, and `proxy_buffering off`
    # keeps frames flowing. Nothing here relaxes authentication or the origin
    # checks: the gateway validates the native bearer itself.
    location = /api/desktop/connect {
        proxy_pass http://127.0.0.1:9877;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host agent.example.com;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host agent.example.com;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # The gateway's readiness endpoint is deliberately NOT published here: it is
    # a loopback diagnostic (`curl http://127.0.0.1:9877/healthz`), and exposing
    # it would advertise the internal port on the public origin. Web readiness
    # is not gateway readiness -- check both, separately.
}

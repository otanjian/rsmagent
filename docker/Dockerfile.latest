# The only maintained production Dockerfile. Digest is the official multiarch
# Python 3.11/bookworm index, verified against registry-1.docker.io.
FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS node-runtime
FROM python:3.11-slim-bookworm@sha256:2333bd330d12de02514770b3585cad313644316047cdee24a7acfdece6de6efb
ARG COW_BUILD_REVISION=unknown
ARG COW_SOURCE_TREE=unknown
ARG TZ=Asia/Shanghai
LABEL org.opencontainers.image.title="rsmagent" \
      org.opencontainers.image.revision="${COW_BUILD_REVISION}" \
      org.opencontainers.image.source-tree="${COW_SOURCE_TREE}"
ENV TZ=${TZ} \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PLAYWRIGHT_BROWSERS_PATH=/app/ms-playwright \
    HOME=/home/agent \
    COW_DATA_DIR=/home/agent/.cow \
    WEB_HOST=0.0.0.0
# Node/npm preserve the bundled script and browser CLI runtime.
COPY --from=node-runtime /usr/local/ /usr/local/
WORKDIR /app
# Keep Debian's normal AND security sources. No source deletion or downgrade.
RUN apt-get update \
    && apt-get install -y --no-install-recommends bash bubblewrap ca-certificates \
       ffmpeg espeak libavcodec-extra tzdata fonts-wqy-zenhei \
    && ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime \
    && echo "${TZ}" > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*
COPY requirements/ /app/requirements/
RUN lock=production-linux-py311.lock \
    && if [ "$(dpkg --print-architecture)" = arm64 ]; then lock=production-linux-arm64-py311.lock; fi \
    && python -m pip install --no-cache-dir --require-hashes -r "requirements/${lock}" \
    && python -m playwright install-deps chromium \
    && python -m playwright install chromium \
    && rm -rf /var/lib/apt/lists/*
# .dockerignore is a runtime allowlist; no instance data enters any layer.
COPY . /app
RUN python -m pip install --no-deps --no-build-isolation /app \
    && groupadd --gid 10001 agent \
    && useradd --uid 10001 --gid agent --shell /bin/bash --create-home agent \
    && mkdir -p /home/agent/cow /home/agent/.cow \
    && chown agent:agent /home/agent/cow /home/agent/.cow \
    && chmod 700 /home/agent/.cow \
    && chmod 755 /app/docker/entrypoint.sh
USER 10001:10001
EXPOSE 9899
ENTRYPOINT ["/app/docker/entrypoint.sh"]
CMD ["python", "app.py"]
